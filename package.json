{
  "name": "game-number-line-jumper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test --config=playwright.config.ts",
    "test:a11y": "npm run build && npm run test:a11y:run",
    "test:a11y:run": "playwright test --config=playwright.accessibility.config.ts",
    "build:host-test": "vite build --mode=e2e --outDir dist-host",
    "preview:host-test": "vite preview --outDir dist-host",
    "test:host": "npm run build:host-test && npm run test:host:run",
    "test:host:run": "playwright test --config=playwright.host.config.ts",
    "check:ip": "node scripts/check-ip-separation.mjs",
    "check:bundle": "node scripts/check-learner-bundle.mjs",
    "release:evidence": "npm run build && node scripts/write-release-evidence.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run build:host-test && npm run check:ip && npm run check:bundle && npm run test:e2e:run && npm run test:a11y:run && npm run test:host:run",
    "test:performance:run": "playwright test --config=playwright.performance.config.ts",
    "perf:bundle": "node scripts/check-bundle-budget.mjs",
    "perf:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=.lighthouserc.cjs",
    "test:performance": "npm run build && npm run test:performance:run && npm run perf:bundle && npm run perf:lighthouse"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
